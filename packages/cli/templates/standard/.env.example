# Majburiy — @BotFather dan oling
BOT_TOKEN=

APP_NAME=__PROJECT_NAME__
APP_ENV=development
APP_DEBUG=true
APP_LOCALE=uz
# Production'da callback imzosi va webhook secret'lari uchun majburiy —
# `telekit key:generate` bilan hosil qiling (yoki hozircha bo'sh qoldiring,
# development rejimida vaqtinchalik kalit avtomatik generatsiya qilinadi).
APP_KEY=

BOT_MODE=auto

DATABASE_DRIVER=sqlite
DATABASE_FILE=storage/telekit.sqlite

LOG_LEVEL=debug
