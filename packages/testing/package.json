{
  "name": "@telekit/testing",
  "version": "0.1.0",
  "description": "Fast Telegram-free bot testing toolkit for Telekit",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/uzbekona-dev/telekit.git", "directory": "packages/testing" },
  "engines": { "node": ">=22.13.0" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest-setup": {
      "types": "./dist/vitest-setup.d.ts",
      "default": "./dist/vitest-setup.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@telekit/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^3.2.7"
  },
  "devDependencies": {
    "@telekit/conversations": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
